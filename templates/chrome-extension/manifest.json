{
  "manifest_version": 3,
  "name": "Extension Name",
  "version": "1.0.0",
  "description": "One-line description of what this extension does",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
